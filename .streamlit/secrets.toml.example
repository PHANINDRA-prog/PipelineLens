# Copy this file to .streamlit/secrets.toml (already git-ignored) and fill in real values,
# or paste the same keys into the Streamlit Community Cloud app's Settings -> Secrets box.
#
# Only ROOT-LEVEL keys (no [section] header) are also exposed as plain environment
# variables, which is what PipelineLens's os.getenv(...)-based config actually reads.
# Do not put these keys under a [section] or the app will not see them.
#
# Everything below is optional. Leave a value blank/commented out to keep that
# feature off; the app runs fully local-only with nothing set here at all.

# --- Optional cloud assist (off unless PIPELINELENS_LLM_MODE is set) ---
# Built-in provider name is "gemini"; a future plugged-in provider (see
# services/cloud_assist.py: register_cloud_assist_provider) can use its own name here
# instead, with zero code changes needed elsewhere.
# PIPELINELENS_LLM_MODE = "gemini"
# PIPELINELENS_LLM_API_KEY = ""
# PIPELINELENS_LLM_MODEL = "gemini-2.0-flash"

# --- Optional read-only GitLab connection (self-hosted GitLab pasted-URL flow) ---
# PIPELINELENS_GITLAB_BASE_URL = "https://gitlab.example"
# PIPELINELENS_GITLAB_TOKEN = ""

# --- Dashboard API resolution (usually leave these unset; "auto" self-hosts) ---
# PIPELINELENS_API_URL = "http://localhost:8000"
# PIPELINELENS_SELF_HOST_API = "auto"

# --- Private local-corpus safety: false by default; only for an approved local model ---
# PIPELINELENS_ALLOW_PRIVATE_CONTEXT = "false"
