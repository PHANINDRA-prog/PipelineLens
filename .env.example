# Runtime
PIPELINELENS_ENV=development
PIPELINELENS_DATABASE_URL=sqlite:///./data/pipelinelens.db
PIPELINELENS_REDIS_URL=redis://redis:6379/0
PIPELINELENS_MAX_LOG_BYTES=500000
PIPELINELENS_MAX_CONTEXT_CHARS=18000

# LLM modes: disabled, gemini (see "Optional cloud assist" in README), openai-compatible.
# A future plugged-in provider (services/cloud_assist.py: register_cloud_assist_provider)
# can use its own mode name here too, with no code changes needed elsewhere.
# Configure an approved cloud endpoint only in the API environment or secret manager.
PIPELINELENS_LLM_MODE=disabled
PIPELINELENS_LLM_BASE_URL=https://api.openai.com/v1
PIPELINELENS_LLM_MODEL=gpt-4.1-mini
PIPELINELENS_LLM_API_KEY=

# Optional local development connection. FastAPI uses this only when
# PIPELINELENS_ENV=development; the dashboard detects it automatically.
PIPELINELENS_GITLAB_BASE_URL=https://gitlab.com
PIPELINELENS_GITLAB_TOKEN=

# Dashboard API resolution. Default "auto" uses PIPELINELENS_API_URL if reachable, else
# self-hosts the API in-process so `streamlit run` alone works. "never" keeps the classic
# two-process-only behavior. See "Run with a single command instead" in README.
PIPELINELENS_API_URL=http://localhost:8000
PIPELINELENS_SELF_HOST_API=auto

# Private local-corpus safety: false by default.
# Enable only for a local model and sanitized, approved data.
PIPELINELENS_ALLOW_PRIVATE_CONTEXT=false